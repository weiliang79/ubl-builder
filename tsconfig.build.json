{
  // The emit project: src/ only, and the only place that writes dist/.
  //
  // `rootDir` is load-bearing rather than decorative. Without it TypeScript
  // infers the root from whatever is in the program, so a single stray import
  // from outside src/ would shift every output path to dist/src/… and silently
  // break all seven subpath exports. Pinning it turns that into a build error.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // A failed build should not leave output behind. Without this, tsc emits
    // despite errors: the TS6059 case above still wrote four files to the repo
    // root before failing.
    "noEmitOnError": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
